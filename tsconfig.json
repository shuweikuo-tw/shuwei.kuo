{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "jsx": "react-jsx",
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "sourceMap": true,
        "plugins": [
            {
                "name": "@manuth/typescript-eslint-plugin",
                "ignoreJavaScript": true,
                "configFile": "custom.eslintrc.js"
            }
        ]
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}